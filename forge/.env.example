# Required: writes the product descriptions (E.V.A parity — OpenAI)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Optional: web search for part-number verification.
# Without these, Forge falls back to direct retailer lookups, then to fixtures.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
BRAVE_API_KEY=

# Optional: override the catalogue Forge harvests from
DESIGN911_BASE_URL=https://www.design911.co.uk
